# 复制这个文件为 .env，填上你的 key 就能从「Mock 模式」切到「真实模型」。
# .env 已在 .gitignore 里，不会被提交。

# ── 方案 A：DeepSeek（推荐，国内直连，便宜）──────────────────────────
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里粘贴你的key

# ── 方案 B：任何 OpenAI 兼容端点 ────────────────────────────────
# 取消下面三行的注释并填写。设了 OPENAI_API_KEY 就优先走这条路。
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 常用国内端点备查（都是 OpenAI 兼容协议）：
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4               glm-4-plus
#   Kimi       https://api.moonshot.cn/v1                         moonshot-v1-8k
#   本地 Ollama http://localhost:11434/v1                          qwen2.5:14b
